# Firebase (web). Copy to .env.local and fill in real values.
# Rotate any key that was previously committed in git history.
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Optional: default Gemini key for local web builds.
# The in-app Settings screen can also store a key in secure storage.
VITE_GEMINI_API_KEY=your-gemini-api-key
GEMINI_API_KEY=your-gemini-api-key

# Set to true to emit structured logs in production builds.
VITE_DEBUG=false

# Optional Sentry DSN. Uncaught errors are captured when this is set.
VITE_SENTRY_DSN=
